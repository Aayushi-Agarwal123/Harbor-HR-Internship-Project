# Copy this file to .env and replace the placeholders.
# Do not commit .env. Do not set HARBOR_RESET when using the development database harbor.

HARBOR_LOCAL_PASSWORD=replace-with-a-local-password
HARBOR_DB_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/harbor
